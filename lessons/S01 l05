          <tr><td>Geostrophic Balance</td><td>Ro ≪ 1</td><td>Steady along-isobar currents</td></tr>
          <tr><td>Vorticity / β-effect</td><td>ζ, β</td><td>Westward gyre intensification</td></tr>
